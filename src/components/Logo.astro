---
import { SITE } from 'astrowind:config';
---

<span class="self-center ml-2 rtl:ml-0 rtl:mr-2 whitespace-nowrap inline-flex items-center gap-2">
  <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true" style="flex: none">
    <rect x="12" y="8" width="40" height="48" fill="var(--sv-surface)"/>
    <rect x="12" y="8" width="40" height="48" fill="none" stroke="var(--sv-text)" stroke-width="5"/>
    <rect x="12" y="8" width="9" height="48" fill="var(--sv-text)"/>
    <rect x="27" y="17" width="18" height="6" fill="var(--sv-text)"/>
    <rect x="27" y="27" width="13" height="5" fill="var(--sv-text)"/>
    <rect x="27" y="35" width="15" height="5" fill="var(--sv-text)"/>
    <rect x="27" y="43" width="10" height="10" fill="var(--sv-pop)"/>
    <rect x="27" y="43" width="10" height="10" fill="none" stroke="var(--sv-text)" stroke-width="3"/>
  </svg>
  <span class="font-display text-2xl md:text-xl font-bold" style="color: var(--sv-text)">{SITE?.name}</span>
</span>
