---
// Ekspor Arsip — salin ringkasan, unduh JSON/CSV, cetak, cabut contoh.
import { vic } from './icons.ts';
---

<section id="ekspor" class="curtain py-16 md:py-24" style="background: var(--sv-surface)" aria-labelledby="ekspor-h">
  <div class="mx-auto max-w-3xl px-5">
    <p class="eyebrow">Bab 4 · Penerbitan</p>
    <h2 id="ekspor-h" class="headword mt-2" style="font-size: clamp(2rem, 7vw, 4rem)">Ekspor Arsip</h2>
    <p class="mt-3 text-lg" style="color: var(--sv-muted)">
      Satu klik untuk pendaftaran beasiswa berikutnya: ringkasannya siap tempel ke formulir,
      datanya siap unduh.
    </p>
    <div class="no-print mt-8 grid gap-4 sm:grid-cols-2">
      <button type="button" id="exp-copy" class="btn magnetic justify-start" data-cursor="link">
        <span set:html={vic('copy', 'w-5 h-5')}></span> Salin ringkasan CV
      </button>
      <button type="button" id="exp-json" class="btn magnetic justify-start" data-cursor="link">
        <span set:html={vic('download', 'w-5 h-5')}></span> Unduh JSON
      </button>
      <button type="button" id="exp-csv" class="btn magnetic justify-start" data-cursor="link">
        <span set:html={vic('download', 'w-5 h-5')}></span> Unduh CSV
      </button>
      <button type="button" id="exp-print" class="btn magnetic justify-start" data-cursor="link">
        <span set:html={vic('printer', 'w-5 h-5')}></span> Cetak / simpan PDF
      </button>
    </div>
    <p id="export-status" class="mt-4 font-bold" aria-live="polite"></p>
    <div class="no-print mt-10 border-t-2 pt-6" style="border-color: var(--sv-line)">
      <button type="button" id="exp-clear-samples" class="btn btn-sm btn-ghost" data-cursor="link">
        <span set:html={vic('trash', 'w-4 h-4')}></span> Cabut semua entri contoh
      </button>
      <p class="mt-2 text-sm" style="color: var(--sv-muted)">Entri contoh ikut saat pertama dibuka supaya kamusnya tidak kosong. Arsip aslimu tidak tersentuh.</p>
    </div>
  </div>
</section>
