---
// Catat Entri Baru — form validasi pesan spesifik (suara Pak Kamus).
import { vic } from './icons.ts';
---

<section id="tambah" class="curtain py-16 md:py-24" aria-labelledby="tambah-h">
  <div class="mx-auto max-w-3xl px-5">
    <p class="eyebrow">Bab 3 · Pencatatan</p>
    <h2 id="tambah-h" class="headword mt-2" style="font-size: clamp(2rem, 7vw, 4rem)">Catat Entri Baru</h2>
    <p class="mt-3 text-lg" style="color: var(--sv-muted)">
      Isi yang bertanda <span aria-hidden="true">*</span> wajib. Arsipmu tersimpan
      <strong> di perambanmu sendiri</strong> — tidak dikirim ke mana-mana.
    </p>

    <form id="entry-form" class="mt-8 grid gap-6 border-2 p-6 md:p-10" style="border-color: var(--sv-text); background: var(--sv-surface)" novalidate>
      <div class="field" data-field="nama">
        <label for="f-nama">Nama sertifikat *</label>
        <input id="f-nama" name="nama" type="text" maxlength="140" placeholder="mis. Juara 1 Lomba Debat Bahasa Indonesia" autocomplete="off" />
        <p class="err" role="alert"></p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="field" data-field="penyelenggara">
          <label for="f-org">Penyelenggara</label>
          <input id="f-org" name="penyelenggara" type="text" maxlength="120" placeholder="mis. Dinas Pendidikan Kab. Kuningan" autocomplete="off" />
          <p class="err" role="alert"></p>
        </div>
        <div class="field" data-field="tanggal">
          <label for="f-date">Tanggal terbit *</label>
          <input id="f-date" name="tanggal" type="date" max="2026-10-12" />
          <p class="err" role="alert"></p>
        </div>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="field" data-field="kategori">
          <label for="f-cat">Kelas kata *</label>
          <select id="f-cat" name="kategori">
            <option value="">— pilih dulu —</option>
            <option value="lomba">Lomba</option>
            <option value="beasiswa">Beasiswa</option>
            <option value="kursus">Kursus / Pelatihan</option>
            <option value="penghargaan">Penghargaan</option>
            <option value="lainnya">Lainnya</option>
          </select>
          <p class="err" role="alert"></p>
        </div>
        <div class="field" data-field="peringkat">
          <label for="f-rank">Peringkat / predikat</label>
          <input id="f-rank" name="peringkat" type="text" maxlength="60" placeholder="mis. Juara 2, Lulus, Peserta" autocomplete="off" />
          <p class="err" role="alert"></p>
        </div>
      </div>
      <div class="field" data-field="catatan">
        <label for="f-note">Definisi (catatan)</label>
        <textarea id="f-note" name="catatan" rows="3" maxlength="500" placeholder="Satu-dua kalimat: apa yang kamu menangkan dan kenapa penting."></textarea>
        <p class="err" role="alert"></p>
      </div>
      <div class="field" data-field="file">
        <label for="f-file">Lampiran berkas <span style="color: var(--sv-muted)">(opsional, PDF/gambar ≤ 5 MB)</span></label>
        <input id="f-file" name="berkas" type="file" accept="application/pdf,image/png,image/jpeg,image/webp" />
        <p class="err" role="alert"></p>
      </div>
      <div>
        <button type="submit" class="btn btn-pop magnetic" data-cursor="link">
          <span set:html={vic('bookmark', 'w-5 h-5')}></span> Catat ke kamus
        </button>
        <p id="form-status" class="mt-4 font-bold" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>
