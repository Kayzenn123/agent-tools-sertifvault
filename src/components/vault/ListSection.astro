---
// Daftar Abjad — filter + cari + daftar entri ala kamus (diisi JS).
import { vic } from './icons.ts';
---

<section id="daftar" class="curtain py-16 md:py-24" style="background: var(--sv-surface)" aria-labelledby="daftar-h">
  <div class="mx-auto max-w-6xl px-5">
    <p class="eyebrow">Bab 2 · Daftar</p>
    <h2 id="daftar-h" class="headword mt-2" style="font-size: clamp(2rem, 7vw, 4rem)">Daftar Abjad</h2>
    <p class="mt-3 max-w-2xl text-lg" style="color: var(--sv-muted)">
      Semua entri tersusun seperti halaman kamus: <em>kata</em>, <span class="kelas-kata">kelas kata</span>,
      lalu definisinya. Saring sesukamu — tautan hasil saringan bisa dibagikan.
    </p>

    <form id="filter-form" class="no-print mt-8 grid gap-4 md:grid-cols-[1fr_220px_160px_auto]" role="search" aria-label="Saring entri">
      <div class="field">
        <label for="fq">Cari kata</label>
        <input id="fq" name="q" type="search" placeholder="mis. poster, beasiswa…" autocomplete="off" />
      </div>
      <div class="field">
        <label for="fk">Kelas kata</label>
        <select id="fk" name="kategori">
          <option value="">Semua jenis</option>
          <option value="lomba">Lomba</option>
          <option value="beasiswa">Beasiswa</option>
          <option value="kursus">Kursus / Pelatihan</option>
          <option value="penghargaan">Penghargaan</option>
          <option value="lainnya">Lainnya</option>
        </select>
      </div>
      <div class="field">
        <label for="ft">Tahun</label>
        <select id="ft" name="tahun"><option value="">Semua tahun</option></select>
      </div>
      <div class="flex items-end gap-3">
        <button type="submit" class="btn btn-sm" data-cursor="link">
          <span set:html={vic('search', 'w-4 h-4')}></span> Saring
        </button>
        <button type="button" id="filter-reset" class="btn btn-sm btn-ghost" data-cursor="link">Hapus</button>
      </div>
    </form>

    <p id="filter-count" class="mt-6 text-sm font-bold" style="color: var(--sv-muted)" aria-live="polite"></p>
    <div id="entry-list" class="entry-lines mt-2"></div>

    <div id="list-empty" class="hidden mt-8 border-2 p-8 text-center" style="border-color: var(--sv-text); background: var(--sv-bg)">
      <p class="font-display text-2xl font-bold">Entri tidak ketemu.</p>
      <p class="mt-2" style="color: var(--sv-muted)">Ejaannya mungkin salah, atau rak ini memang belum punya kata itu. Coba kata lain — atau catat sebagai entri baru.</p>
      <a href="#tambah" class="btn btn-sm btn-pop mt-6 magnetic" data-cursor="link">
        <span set:html={vic('plus', 'w-4 h-4')}></span> Catat entri baru
      </a>
    </div>
  </div>
</section>
