---
// Peta Entri — canvas pan/zoom (DOM). Titik = sertifikat bernomor entri.
import { vic } from './icons.ts';
---

<section id="peta" class="curtain py-16 md:py-24" aria-labelledby="peta-h">
  <div class="mx-auto max-w-6xl px-5">
    <p class="eyebrow">Bab 1 · Peta</p>
    <h2 id="peta-h" class="headword mt-2" style="font-size: clamp(2rem, 7vw, 4rem)">Peta Entri</h2>
    <p class="mt-3 max-w-2xl text-lg" style="color: var(--sv-muted)">
      Seret untuk menjelajah, cubit atau putar roda tetikus untuk zum. Setiap titik adalah satu
      entri kamus — <span class="stabilo font-bold">klik titiknya</span> untuk membuka definisinya.
    </p>

    <div class="no-print mt-6 flex flex-wrap items-center gap-3" role="toolbar" aria-label="Kontrol peta">
      <button type="button" class="btn btn-sm" data-map-zoom="in" data-cursor="link">
        <span set:html={vic('plus', 'w-4 h-4')}></span> Zum masuk
      </button>
      <button type="button" class="btn btn-sm btn-ghost" data-map-zoom="out" data-cursor="link">
        <span set:html={vic('minus', 'w-4 h-4')}></span> Zum keluar
      </button>
      <button type="button" class="btn btn-sm btn-ghost" data-map-zoom="reset" data-cursor="link">Setel ulang</button>
      <span class="text-sm ml-auto hidden md:inline" style="color: var(--sv-muted)">
        Keyboard: ← → ↑ ↓ geser · + − zum
      </span>
    </div>

    <div
      id="map-viewport"
      class="map-viewport mt-4 rounded-none"
      style="height: min(68vh, 560px)"
      tabindex="0"
      role="application"
      aria-label="Peta entri sertifikat. Seret untuk menggeser, gunakan tombol zum atau keyboard."
      data-cursor="view"
    >
      <div class="map-world"></div>
      <p class="map-live sr-only" aria-live="polite"></p>
      <p class="map-hint no-print">seret · zum · klik titik</p>
    </div>
    <p class="mt-3 text-sm" style="color: var(--sv-muted)">
      Titik berstabilo = entri contoh (boleh dicabut kapan saja di bawah).
    </p>
  </div>
</section>
