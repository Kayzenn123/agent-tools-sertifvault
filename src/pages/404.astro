---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import '~/assets/styles/vault.css';

const title = `404 — Entri tidak ada di kamus`;
---

<Layout metadata={{ title }}>
  <Fragment slot="announcement" />
  <section class="mx-auto max-w-3xl px-5 py-28 text-center">
    <p class="font-accent text-sm tracking-[0.22em] uppercase" style="color: var(--sv-accent)">Kamus · 404</p>
    <h1 class="headword mt-4" style="font-size: clamp(4rem, 18vw, 10rem)">404</h1>
    <p class="mt-4 text-xl font-bold">Kata ini belum tercatat di kamus.</p>
    <p class="mt-2 text-lg" style="color: var(--sv-muted)">
      Halaman yang kamu cari tidak ada entrinya — mungkin salah eja di bilah alamat,
      atau halamannya sudah dicabut dari rak.
    </p>
    <a href={getHomePermalink()} class="btn btn-pop mt-8">Kembali ke kamus</a>
  </section>
</Layout>
